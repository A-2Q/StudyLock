<Window x:Class="StudyLock.Views.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource BorderAccentBrush}"
            BorderThickness="1.2"
            CornerRadius="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurface2Brush}"
                    CornerRadius="15,15,0,0"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📝" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource NotesTitle}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,3"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- Notes Editor -->
            <TextBox x:Name="NotesTextBox"
                     Grid.Row="1"
                     Background="{DynamicResource BgSurface1Brush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource AccentPrimaryBrush}"
                     BorderThickness="0"
                     Padding="14"
                     FontSize="14"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="NotesTextBox_TextChanged" />

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgSurface2Brush}"
                    CornerRadius="0,0,15,15"
                    Padding="14,8">
                <TextBlock Text="{DynamicResource NotesAutoSaveHint}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>

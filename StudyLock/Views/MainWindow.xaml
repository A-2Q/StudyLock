<Window x:Class="StudyLock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyLock"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgSurface1Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="18,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,26">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="12" Background="#F4F7FB" BorderBrush="{DynamicResource BorderAccentBrush}" BorderThickness="1.2" Padding="5">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AppTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="v1.0 • by A-2Q"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource AppSubtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>

                <!-- Primary Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavStudyTab"
                                 GroupName="MainNav"
                                 IsChecked="True"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📚" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource TabStudyMode}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavChildTab"
                                 GroupName="MainNav"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧸" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource TabChildMode}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavStatsTab"
                                 GroupName="MainNav"
                                 Style="{StaticResource NavTabRadioStyle}"
                                 Checked="NavTab_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource TabStatistics}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Controls: Discord Credits, Parent PIN, Theme, Language -->
                <StackPanel Grid.Row="2">
                    <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,12" />

                    <!-- Discord Credits & Community Button -->
                    <Button Margin="0,0,0,8"
                            Padding="10,9"
                            Cursor="Hand"
                            ToolTip="https://discord.gg/PufJHjaAKJ"
                            Click="DiscordButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DiscordRoot"
                                        Background="#1F5865F2"
                                        BorderBrush="#735865F2"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="#5865F2" Padding="5">
                                            <Viewbox Stretch="Uniform">
                                                <Path Fill="#FFFFFF"
                                                      Data="M20.317,4.37 C18.787,3.669 17.147,3.158 15.432,2.864 C15.221,3.24 14.975,3.745 14.806,4.147 C12.982,3.874 11.175,3.874 9.385,4.147 C9.216,3.745 8.965,3.24 8.752,2.864 C7.035,3.158 5.393,3.671 3.863,4.374 C0.768,9.002 -0.071,13.516 0.348,17.967 C2.399,19.479 4.387,20.398 6.341,21.001 C6.824,20.341 7.254,19.639 7.625,18.9 C6.919,18.634 6.244,18.306 5.605,17.926 C5.774,17.802 5.939,17.673 6.099,17.539 C9.992,19.338 14.219,19.338 18.066,17.539 C18.228,17.673 18.393,17.802 18.56,17.926 C17.92,18.308 17.243,18.636 16.537,18.902 C16.908,19.64 17.336,20.343 17.821,21.003 C19.777,20.4 21.767,19.481 23.818,17.967 C24.31,12.809 22.978,8.336 20.317,4.37 Z M8.02,15.331 C6.838,15.331 5.868,14.244 5.868,12.912 C5.868,11.58 6.817,10.491 8.02,10.491 C9.223,10.491 10.193,11.58 10.172,12.912 C10.172,14.244 9.223,15.331 8.02,15.331 Z M15.975,15.331 C14.793,15.331 13.823,14.244 13.823,12.912 C13.823,11.58 14.772,10.491 15.975,10.491 C17.178,10.491 18.148,11.58 18.127,12.912 C18.127,14.244 17.178,15.331 15.975,15.331 Z" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource DiscordBtnLabel}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{DynamicResource DiscordCreditsSub}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DiscordRoot" Property="Background" Value="#365865F2" />
                                        <Setter TargetName="DiscordRoot" Property="BorderBrush" Value="#5865F2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource ParentPinSettingsBtn}"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,0,8"
                            Click="ParentPinSettingsButton_Click" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ThemeToggleButton"
                                Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource ThemeLightLabel}"
                                Padding="8,8"
                                Click="ThemeToggleButton_Click" />
                        <Button x:Name="LanguageToggleButton"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource ToggleLanguageLabel}"
                                Padding="8,8"
                                Click="LanguageToggleButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32,26">
            <Grid MaxWidth="860">

                <!-- ========================================================= -->
                <!-- TAB 1: STUDY MODE SETUP                                   -->
                <!-- ========================================================= -->
                <StackPanel x:Name="StudyModePanel" Visibility="Visible">
                    <TextBlock Text="{DynamicResource StudyHeaderTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource StudyHeaderDesc}"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22" />

                    <!-- Card 1: Study Website & Presets -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StudyUrlLabel}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="StudyUrlTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         FlowDirection="LeftToRight" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="16,10"
                                        Click="PreviewBeforeLockButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👁" Margin="0,0,7,0" />
                                        <TextBlock Text="{DynamicResource PreviewBeforeLockBtn}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,2,0,8">
                                <TextBlock Text="{DynamicResource SavedStudySitesLabel}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="{DynamicResource AddSiteBtn}"
                                        Foreground="{DynamicResource AccentPrimaryBrush}"
                                        Click="AddStudyPresetButton_Click" />
                            </Grid>

                            <WrapPanel x:Name="StudyPresetsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Attached Local PDFs -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource AttachedPdfsLabel}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6"
                                        Content="{DynamicResource AddPdfBtn}"
                                        Click="AttachPdfButton_Click" />
                            </Grid>

                            <TextBlock x:Name="NoPdfsHintText"
                                       Text="{DynamicResource NoPdfsAttached}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />

                            <WrapPanel x:Name="AttachedPdfsPanel" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Duration -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DurationLabel}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />

                            <WrapPanel x:Name="StudyDurationChipsPanel">
                                <RadioButton GroupName="StudyDur" Tag="5" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip5m}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="15" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip15m}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="30" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip30m}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="60" IsChecked="True" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip1h}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="120" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip2h}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="180" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip3h}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="240" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip4h}" Checked="StudyDurationChip_Checked" />
                                <RadioButton GroupName="StudyDur" Tag="300" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip5h}" Checked="StudyDurationChip_Checked" />
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource CustomMinutesLabel}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBox x:Name="StudyCustomMinutesBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         FontFamily="{StaticResource MonoFont}"
                                         Width="90"
                                         Padding="10,6"
                                         Text="60"
                                         TextChanged="StudyCustomMinutesBox_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Lock Protection Level -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LockLevelLabel}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="StandardLevelRadio"
                                             Grid.Column="0"
                                             GroupName="LockLevel"
                                             IsChecked="True"
                                             Style="{StaticResource SelectableCardRadioStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🔒" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource StandardLevelTitle}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource StandardLevelDesc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="StrictLevelRadio"
                                             Grid.Column="2"
                                             GroupName="LockLevel"
                                             Style="{StaticResource SelectableCardRadioStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource StrictLevelTitle}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource StrictLevelDesc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border x:Name="StudyErrorBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource DangerSubtleBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="StudyErrorText"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Primary Start CTA -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="15.5"
                            Padding="24,15"
                            Content="{DynamicResource StartStudyLockBtn}"
                            Click="StartStudySessionButton_Click" />
                </StackPanel>

                <!-- ========================================================= -->
                <!-- TAB 2: CHILD MODE SETUP                                   -->
                <!-- ========================================================= -->
                <StackPanel x:Name="ChildModePanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource ChildHeaderTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource ChildHeaderDesc}"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22" />

                    <!-- Visual Child Site Cards Grid -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource ChildSitesGridLabel}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{DynamicResource AddChildSiteBtn}"
                                        Click="AddChildPresetButton_Click" />
                            </Grid>

                            <WrapPanel x:Name="ChildPresetsPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Child Duration -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ChildDurationLabel}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <WrapPanel x:Name="ChildDurationChipsPanel">
                                <RadioButton GroupName="ChildDur" Tag="5" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip5m}" Checked="ChildDurationChip_Checked" />
                                <RadioButton GroupName="ChildDur" Tag="15" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip15m}" Checked="ChildDurationChip_Checked" />
                                <RadioButton GroupName="ChildDur" Tag="30" IsChecked="True" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip30m}" Checked="ChildDurationChip_Checked" />
                                <RadioButton GroupName="ChildDur" Tag="60" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip1h}" Checked="ChildDurationChip_Checked" />
                                <RadioButton GroupName="ChildDur" Tag="120" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip2h}" Checked="ChildDurationChip_Checked" />
                                <RadioButton GroupName="ChildDur" Tag="180" Style="{StaticResource DurationChipStyle}" Content="{DynamicResource Chip3h}" Checked="ChildDurationChip_Checked" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource CustomMinutesLabel}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBox x:Name="ChildCustomMinutesBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         FlowDirection="LeftToRight"
                                         FontFamily="{StaticResource MonoFont}"
                                         Width="90"
                                         Padding="10,6"
                                         Text="30"
                                         TextChanged="ChildCustomMinutesBox_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Child Error Banner -->
                    <Border x:Name="ChildErrorBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource DangerSubtleBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="ChildErrorText"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="15.5"
                            Padding="24,15"
                            Content="{DynamicResource StartChildLockBtn}"
                            Click="StartChildSessionButton_Click" />
                </StackPanel>

                <!-- ========================================================= -->
                <!-- TAB 3: STATISTICS & SESSION HISTORY                       -->
                <!-- ========================================================= -->
                <StackPanel x:Name="StatisticsPanel" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource StatsHeaderTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource StatsHeaderDesc}"
                               FontSize="13.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,22" />

                    <!-- 4 KPI Telemetry Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StatTodayHours}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="StatTodayValue" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,6,0,0" Text="0.0" />
                                <TextBlock Text="{DynamicResource HoursUnit}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StatWeekHours}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="StatWeekValue" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}" Margin="0,6,0,0" Text="0.0" />
                                <TextBlock Text="{DynamicResource HoursUnit}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StatTotalHours}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="StatTotalValue" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,6,0,0" Text="0.0" />
                                <TextBlock Text="{DynamicResource HoursUnit}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource StatAvgAfk}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="StatAvgAfkValue" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" Text="—" />
                                <TextBlock Text="{DynamicResource SecondsUnit}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- History List -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SessionHistoryTitle}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <TextBlock x:Name="NoHistoryText"
                                       Text="{DynamicResource NoHistoryYet}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,8" />

                            <StackPanel x:Name="HistoryListPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

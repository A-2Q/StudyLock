<Window x:Class="StudyLock.Views.AddEditPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource BorderAccentBrush}"
            BorderThickness="1.3"
            CornerRadius="18"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="DialogHeaderText"
                       Text="{DynamicResource AddPresetTitle}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16" />

            <TextBlock Text="{DynamicResource PresetNameLabel}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource PresetUrlLabel}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="UrlTextBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FlowDirection="LeftToRight"
                     Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource PresetIconLabel}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <WrapPanel x:Name="IconPickerPanel" Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource PresetColorLabel}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6" />
            <WrapPanel x:Name="ColorPickerPanel" Margin="0,0,0,12" />

            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource SaveBtn}"
                        Click="SaveButton_Click" />
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource CancelBtn}"
                        Click="CancelButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>

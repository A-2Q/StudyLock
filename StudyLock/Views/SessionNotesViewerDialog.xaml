<Window x:Class="StudyLock.Views.SessionNotesViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource BorderAccentBrush}"
            BorderThickness="1.3"
            CornerRadius="18"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="SessionTitleText"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SessionMetaText"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <TextBox x:Name="NotesViewerBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     Background="{DynamicResource BgSurface2Brush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     BorderThickness="1"
                     Padding="14"
                     FontSize="14"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource CopyBtn}"
                        Margin="0,0,8,0"
                        Click="CopyButton_Click" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource ExportTxtBtn}"
                        Margin="0,0,8,0"
                        Click="ExportButton_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource CloseBtn}"
                        Padding="18,9"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="StudyLock.Views.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310"
        Height="435"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CalcKeyStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style x:Key="CalcOpStyle" TargetType="Button" BasedOn="{StaticResource CalcKeyStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource BorderAccentBrush}"
            BorderThickness="1.2"
            CornerRadius="16"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgSurface2Brush}"
                    CornerRadius="15,15,0,0"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧮" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource CalcTitle}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,3"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- Display -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgCanvasBrush}"
                    CornerRadius="12"
                    Margin="12,12,12,8"
                    Padding="14,10"
                    FlowDirection="LeftToRight">
                <StackPanel>
                    <TextBlock x:Name="ExpressionDisplay"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               Text="" />
                    <TextBlock x:Name="MainDisplay"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Text="0" />
                </StackPanel>
            </Border>

            <!-- Keypad -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="8,0,8,10" FlowDirection="LeftToRight">
                <Button Style="{StaticResource CalcOpStyle}" Content="C" Click="Clear_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="⌫" Click="Backspace_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="√" Click="Sqrt_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="÷" Tag="/" Click="Operator_Click" />

                <Button Style="{StaticResource CalcKeyStyle}" Content="7" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="8" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="9" Click="Digit_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="×" Tag="*" Click="Operator_Click" />

                <Button Style="{StaticResource CalcKeyStyle}" Content="4" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="5" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="6" Click="Digit_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="−" Tag="-" Click="Operator_Click" />

                <Button Style="{StaticResource CalcKeyStyle}" Content="1" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="2" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="3" Click="Digit_Click" />
                <Button Style="{StaticResource CalcOpStyle}" Content="+" Tag="+" Click="Operator_Click" />

                <Button Style="{StaticResource CalcKeyStyle}" Content="±" Click="Negate_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="0" Click="Digit_Click" />
                <Button Style="{StaticResource CalcKeyStyle}" Content="." Click="Decimal_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="4" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="20" Content="=" Click="Equals_Click" />
            </UniformGrid>
        </Grid>
    </Border>
</Window>

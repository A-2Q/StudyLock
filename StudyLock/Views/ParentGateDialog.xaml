<Window x:Class="StudyLock.Views.ParentGateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource BorderAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="18"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="🔐" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ParentGateTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- Math Challenge Expression Box -->
            <Border x:Name="MathBox"
                    Background="{DynamicResource BgSurface2Brush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,10,0,14">
                <TextBlock x:Name="ExpressionText"
                           FlowDirection="LeftToRight"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Text="20 - 10 - 5 = ?" />
            </Border>

            <!-- Answer Input (Math Mode) -->
            <TextBox x:Name="AnswerTextBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FlowDirection="LeftToRight"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="20"
                     HorizontalContentAlignment="Center"
                     Margin="0,0,0,12"
                     KeyDown="Input_KeyDown" />

            <!-- PIN Input (PIN Mode) -->
            <PasswordBox x:Name="PinPasswordBox"
                         Style="{StaticResource ModernPasswordBoxStyle}"
                         FlowDirection="LeftToRight"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="20"
                         MaxLength="8"
                         Visibility="Collapsed"
                         Margin="0,8,0,12"
                         KeyDown="Input_KeyDown" />

            <!-- Feedback / Lockout Banner -->
            <Border x:Name="StatusBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource DangerSubtleBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </Border>

            <!-- Action Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="VerifyButton"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource ParentGateVerifyBtn}"
                        Click="VerifyButton_Click" />
                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource ParentGateCancelBtn}"
                        Click="CancelButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>

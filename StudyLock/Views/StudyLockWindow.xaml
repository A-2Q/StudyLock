<Window x:Class="StudyLock.Views.StudyLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource BgCanvasBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Smart Top Control Bar -->
            <RowDefinition Height="Auto" /> <!-- Browser Tabs & Split Controls -->
            <RowDefinition Height="Auto" /> <!-- 30s Grace Period Banner -->
            <RowDefinition Height="Auto" /> <!-- 15-Min Anti-AFK Banner -->
            <RowDefinition Height="Auto" /> <!-- Blocked Domain Toast -->
            <RowDefinition Height="*" />    <!-- Main WebView / Split Viewport -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Smart Top Control Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurface1Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Timers & Pause -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Main Countdown -->
                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource BorderAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,5"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LockModeIcon" Text="🔒" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="MainCountdownText"
                                       FlowDirection="LeftToRight"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}"
                                       Text="01:00:00" />
                        </StackPanel>
                    </Border>

                    <!-- Next 15-Min Check-In Countdown -->
                    <Border x:Name="NextCheckContainer"
                            Background="{DynamicResource BgSurface2Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,6"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource NextCheckLabel}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock x:Name="NextCheckCountdownText"
                                       FlowDirection="LeftToRight"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="15:00" />
                        </StackPanel>
                    </Border>

                    <!-- Pause / Resume Button -->
                    <Button x:Name="PauseResumeButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource PauseTimerBtn}"
                            Padding="12,7"
                            Margin="0,0,8,0"
                            Click="PauseResumeButton_Click" />

                    <!-- Paused Badge -->
                    <Border x:Name="PausedStatusBadge"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningSubtleBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5">
                        <TextBlock Text="{DynamicResource PausedBadge}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>

                <!-- Utility Tools & Split View -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SplitToggleButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource SplitViewBtn}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="SplitToggleButton_Click" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource QuickNotesBtn}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="NotesButton_Click" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource CalculatorBtn}"
                            Padding="11,7"
                            Margin="0,0,6,0"
                            Click="CalculatorButton_Click" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource WifiBtn}"
                            Padding="11,7"
                            Margin="0,0,10,0"
                            Click="WifiButton_Click" />
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource EmergencyExitBtn}"
                            Padding="12,7"
                            Click="EmergencyExitButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Browser Navigation + Tabs Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSurface2Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="←" FontSize="14" Padding="9,5" Click="NavBack_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="→" FontSize="14" Padding="9,5" Click="NavForward_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="↻" FontSize="14" Padding="9,5" Click="NavReload_Click" />
                </StackPanel>

                <!-- Tabs Strip (Single View Mode) -->
                <ScrollViewer x:Name="TabsScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>

                <!-- Split View Pane Selectors (Shown only in Split View) -->
                <StackPanel x:Name="SplitSelectorsPanel"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource LeftPaneLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="LeftPaneSelector"
                              Width="180"
                              Margin="0,0,12,0"
                              SelectionChanged="PaneSelector_SelectionChanged" />
                    <TextBlock Text="{DynamicResource RightPaneLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="RightPaneSelector"
                              Width="180"
                              SelectionChanged="PaneSelector_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: 30-Second Grace Period Banner -->
        <Border x:Name="GraceBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{DynamicResource InfoSubtleBrush}"
                BorderBrush="{DynamicResource InfoBrush}"
                BorderThickness="0,0,0,1.5"
                Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource GraceBannerText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="GraceCountdownText"
                               FlowDirection="LeftToRight"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InfoBrush}"
                               VerticalAlignment="Center"
                               Text="30s" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource LockNowBtn}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="LockNowButton_Click" />
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{DynamicResource CancelStartBtn}"
                            Padding="12,6"
                            Click="CancelStartButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: 15-Minute Anti-AFK Verification Banner -->
        <Border x:Name="AntiAfkBanner"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{DynamicResource WarningSubtleBrush}"
                BorderBrush="{DynamicResource AccentPrimaryBrush}"
                BorderThickness="0,0,0,2"
                Padding="18,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AntiAfkBannerTitle}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock x:Name="AntiAfkMessageText"
                                   Text="{DynamicResource AntiAfkBannerActive}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource BgSurface1Brush}"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AntiAfkGraceText"
                                   FlowDirection="LeftToRight"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   Text="60s" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SuccessButtonStyle}"
                        Content="{DynamicResource IAmStudyingBtn}"
                        Padding="22,10"
                        Click="IAmStudyingButton_Click" />
            </Grid>
        </Border>

        <!-- ROW 4: Blocked Domain Subtle Notification -->
        <Border x:Name="BlockedToastBanner"
                Grid.Row="4"
                Visibility="Collapsed"
                Background="{DynamicResource DangerSubtleBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,6">
            <TextBlock x:Name="BlockedToastText"
                       Text="{DynamicResource BlockedDomainToast}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- ROW 5: Viewport (Single Mode or Draggable Split View) -->
        <Grid x:Name="ViewportGrid" Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="*" />
                <ColumnDefinition x:Name="SplitterColumnDef" Width="0" />
                <ColumnDefinition x:Name="RightColumnDef" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Primary / Left Host -->
            <Grid x:Name="LeftWebHost" Grid.Column="0" Background="{DynamicResource BgCanvasBrush}" />

            <!-- Draggable Split Divider -->
            <GridSplitter x:Name="SplitDivider"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderStrongBrush}"
                          Visibility="Collapsed" />

            <!-- Secondary / Right Host (Split View) -->
            <Grid x:Name="RightWebHost" Grid.Column="2" Background="{DynamicResource BgCanvasBrush}" Visibility="Collapsed" />
        </Grid>

        <!-- Session Completed Overlay -->
        <Grid x:Name="CompletedOverlay"
              Grid.Row="0"
              Grid.RowSpan="6"
              Visibility="Collapsed"
              Background="{DynamicResource BgCanvasBrush}">
            <Border Background="{DynamicResource BgSurface1Brush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1.5"
                    CornerRadius="24"
                    Padding="44,38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="580">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource SessionCompletedTitle}"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource SessionCompletedDesc}"
                               FontSize="14.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <TextBlock x:Name="CompletedSummaryText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,26" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Padding="28,13"
                            FontSize="15"
                            Content="{DynamicResource ReturnToDashboardBtn}"
                            Click="ReturnToDashboardButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="StudyLock.Views.EmergencyExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{DynamicResource BgSurface1Brush}"
            BorderBrush="{DynamicResource DangerBrush}"
            BorderThickness="1.5"
            CornerRadius="18"
            Padding="24"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource DangerSubtleBrush}">
                    <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource EmergencyTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="{DynamicResource EmergencyDesc}"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="560" />
                </StackPanel>
            </StackPanel>

            <!-- Unselectable 55-char Target Code Display -->
            <Border Background="{DynamicResource BgSurface2Brush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Margin="0,6,0,12">
                <StackPanel>
                    <TextBlock x:Name="TargetCodeText"
                               FlowDirection="LeftToRight"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentPrimaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock x:Name="ProgressText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Text="0 / 55" />
                </StackPanel>
            </Border>

            <!-- Paste-Disabled Input Box -->
            <TextBox x:Name="CodeInputBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FlowDirection="LeftToRight"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="15"
                     ContextMenu="{x:Null}"
                     TextChanged="CodeInputBox_TextChanged"
                     PreviewKeyDown="CodeInputBox_PreviewKeyDown"
                     Margin="0,0,0,10" />

            <TextBlock x:Name="PasteWarningText"
                       Visibility="Collapsed"
                       Text="{DynamicResource EmergencyPasteBlocked}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ConfirmButton"
                        Grid.Column="0"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="{DynamicResource EmergencyConfirmBtn}"
                        IsEnabled="False"
                        Click="ConfirmButton_Click" />
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource EmergencyBackBtn}"
                        Click="CancelButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>

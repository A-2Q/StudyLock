<Window x:Class="StudyLock.Views.PreviewBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StudyLock — Preview"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1160"
        Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Preview Top Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgSurface1Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Content="←" FontSize="15" Click="BackButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="↻" FontSize="15" Click="ReloadButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource PreviewTitle}"
                               FontWeight="Bold"
                               FontSize="14.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource PreviewHint}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource PreviewCloseBtn}"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource PreviewConfirmStartBtn}"
                            Click="ConfirmStartButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Persistent Study Profile WebView2 -->
        <wv2:WebView2 x:Name="PreviewWebView" Grid.Row="1" />
    </Grid>
</Window>

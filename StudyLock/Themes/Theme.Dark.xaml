<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Signature OLED Charcoal & Sunrise Gold Theme -->
    <Color x:Key="CanvasColor">#08090B</Color>
    <Color x:Key="Surface1Color">#0E1015</Color>
    <Color x:Key="Surface2Color">#14171F</Color>
    <Color x:Key="Surface3Color">#1C202B</Color>
    <Color x:Key="AccentPrimaryColor">#F59E0B</Color>
    <Color x:Key="AccentHoverColor">#FBBF24</Color>
    <Color x:Key="AccentPressedColor">#D97706</Color>
    <Color x:Key="AccentSubtleColor">#1FF59E0B</Color>
    <Color x:Key="AccentGlowColor">#47F59E0B</Color>
    <Color x:Key="BorderSubtleColor">#14FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#24FFFFFF</Color>
    <Color x:Key="BorderAccentColor">#73F59E0B</Color>
    <Color x:Key="TextPrimaryColor">#F4F5F8</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextMutedColor">#646B78</Color>
    <Color x:Key="TextOnAccentColor">#0B0C10</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSubtleColor">#2210B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSubtleColor">#24F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSubtleColor">#24EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoSubtleColor">#223B82F6</Color>

    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="BgSurface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="BgSurface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="BgSurface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource SuccessSubtleColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtleColor}" />
</ResourceDictionary>
